# Server Configuration
# NOTE: The PORT variable must be set as an environment variable in your shell,
# not in this .env file. Next.js reads PORT from the shell environment directly.
# 
# Example usage:
#   PORT=3001 npm run dev           (Unix-like systems)
#   $env:PORT=3001; npm run dev     (Windows PowerShell)
#   set PORT=3001 && npm run dev    (Windows CMD)
#
# Default port: 3000

# API Configuration
# The stats API is served same-origin by this app's /api/v1 route handlers, so the
# browser client uses relative paths. NEXT_PUBLIC_API_URL is an optional override only.
# NEXT_PUBLIC_API_URL=

# ShardsSMPv2 stats database (shards_v2) — read by the /api/v1 route handlers.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shards_v2
DB_USER=shards_v2
DB_PASSWORD=

# Add other application-specific environment variables here
# NODE_ENV=production
